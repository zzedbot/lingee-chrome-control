{
  "manifest_version": 3,
  "name": "Lingee Browser Agent Bridge",
  "version": "0.2.2",
  "description": "Connects supported browsers to explicitly authorized Lingee browser-control agents.",
  "homepage_url": "https://app.lingee.com",
  "icons": {
    "16": "icons/lingee-16.png",
    "32": "icons/lingee-32.png",
    "48": "icons/lingee-48.png",
    "128": "icons/lingee-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation"
  ],
  "optional_permissions": [
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/lingee-48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lingee Browser Agent Bridge",
    "default_icon": {
      "16": "icons/lingee-16.png",
      "32": "icons/lingee-32.png",
      "48": "icons/lingee-48.png",
      "128": "icons/lingee-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "incognito": "split"
}
